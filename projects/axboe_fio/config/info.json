{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lfio",
    "-lpthread",
    "-ldl",
    "-lm",
    "-lz",
    "-DCONFIG_HAVE_GETTID"
  ],
  "codegen": {
