{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lsherpa-onnx-cxx-api",
    "-lsherpa-onnx-c-api",
    "-lsherpa-onnx-core",
    "-lonnxruntime",
    "-lkaldi-native-fbank-core",
    "-lkissfft-float",
    "-lkaldi-decoder-core",
    "-lssentencepiece_core",
    "-lsherpa-onnx-kaldifst-core",
    "-lsherpa-onnx-fstfar",
    "-lsherpa-onnx-fst",
    "-lpthread",
    "-ldl",
    "-lm"
