{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-DWITH_STDLIB",
    "/fuzz/install/lib/rand.o",
    "-Wl,--start-group",
    "-lsign",
    "-lec",
    "-larith",
    "-Wl,--end-group",
    "-lm"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/libsig.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/libec.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/libarith.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "WITH_STDLIB",
        "value": "1"
      }
    ]
  }
}