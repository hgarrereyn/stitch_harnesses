{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lglfw3",
    "-lX11",
    "-lXrandr",
    "-lXi",
    "-lXinerama",
    "-lXcursor",
    "-ldl",
    "-lpthread"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/GLFW/glfw3.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/GLFW/glfw3native.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "GLFW_INCLUDE_NONE",
        "value": "1"
      }
    ]
  }
}