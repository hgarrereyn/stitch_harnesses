{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lpfring",
    "-lpcap",
    "-lpthread",
    "-ldl",
    "-lnl-genl-3",
    "-lnl-3",
    "-lrt"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/pfring.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/pfring_mod_pcap.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/pfring_zc.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/pfring_ft.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/nbpf.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "ENABLE_BPF",
        "value": "1"
      }
    ]
  }
}