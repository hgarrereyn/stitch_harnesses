{
  "build_flags": [
    "-I/fuzz/install/include",
    "-I/fuzz/install/include/hashcat",
    "-I/fuzz/src/OpenCL",
    "-I/fuzz/src/deps/OpenCL-Headers",
    "-I/fuzz/src/deps/LZMA-SDK/C",
    "-I/fuzz/src/deps/zlib",
    "-I/fuzz/src/deps/zlib/contrib",
    "-L/fuzz/install/lib",
    "-Wl,-rpath,/fuzz/install/lib",
    "-lhashcat",
    "-lpthread",
    "-ldl",
    "-lrt",
    "-lm"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/hashcat/types.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/hashcat/hashcat.h",
        "language": "c"
      }
    ],
    "defines": []
  }
}