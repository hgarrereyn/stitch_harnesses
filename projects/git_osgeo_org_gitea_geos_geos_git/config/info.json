{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lgeos_c",
    "-lgeos",
    "-pthread"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/geos.h",
        "language": "cpp"
      },
      {
        "path": "/fuzz/install/include/geos_c.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "USE_UNSTABLE_GEOS_CPP_API",
        "value": "1"
      }
    ]
  }
}