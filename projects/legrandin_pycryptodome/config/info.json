{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lpycryptodome"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/errors.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/endianess.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/common.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "HAVE_STDINT_H",
        "value": "1"
      },
      {
        "name": "HAVE_POSIX_MEMALIGN",
        "value": "1"
      }
    ]
  }
}