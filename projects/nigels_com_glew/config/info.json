{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-L/fuzz/install/lib64",
    "-Wl,-rpath,/fuzz/install/lib64",
    "-Wl,-rpath,/fuzz/install/lib",
    "-lGLEW",
    "-lGL",
    "-lX11",
    "-DGLEW_NO_GLU"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/GL/glew.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/GL/glxew.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/GL/eglew.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "GLEW_NO_GLU",
        "value": "1"
      }
    ]
  }
}