{
  "build_flags": [
    "-I/fuzz/install/include",
    "-I/fuzz/src",
    "-L/fuzz/install/lib",
    "-Wl,--start-group",
    "-lXNNPACK",
    "-lxnnpack-microkernels-prod",
    "-lcpuinfo",
    "-lpthreadpool",
    "-Wl,--end-group",
    "-lpthread",
    "-ldl",
    "-lm"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/xnnpack.h",
        "language": "cpp"
      },
      {
        "path": "/fuzz/install/include/experimental.h",
        "language": "cpp"
      }
    ],
    "defines": []
  }
}