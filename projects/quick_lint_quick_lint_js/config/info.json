    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lquick-lint-js-lib",
    "-lquick-lint-js-diagnostic-metadata",
    "-lquick-lint-js-i18n",
    "-lquick-lint-js-tool-lib",
    "-lquick-lint-js-trace",
