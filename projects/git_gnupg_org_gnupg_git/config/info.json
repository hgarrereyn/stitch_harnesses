{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lcommon",
    "-lgcrypt",
    "-lgpg-error",
    "-include",
    "gpg-error.h",
    "-DHAVE_ISASCII=1",
    "-DHAVE_STRPBRK=1",
    "-DHAVE_MEMRCHR=1"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/gnupg/types.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/gnupg/stringhelp.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "HAVE_ISASCII",
        "value": "1"
      },
      {
        "name": "HAVE_STRPBRK",
        "value": "1"
      },
      {
        "name": "HAVE_MEMRCHR",
        "value": "1"
      }
    ]
  }
}