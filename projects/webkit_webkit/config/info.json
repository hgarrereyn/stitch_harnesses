{
  "build_flags": [
    "-I/fuzz/install/include",
    "-L/fuzz/install/lib",
    "-lxdgmime",
    "-DXDG_PREFIX=_wk_xdg",
    "-DLITTLE_ENDIAN=1"
  ],
  "codegen": {
    "headers": [
      {
        "path": "/fuzz/install/include/xdgmime/xdgmime.h",
        "language": "c"
      }
    ],
    "defines": [
      {
        "name": "XDG_PREFIX",
        "value": "_wk_xdg"
      },
      {
        "name": "LITTLE_ENDIAN",
        "value": "1"
      }
    ]
  }
}