        "language": "c"
      },
      {
        "path": "/fuzz/install/include/fuse3/cuse_lowlevel.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/fuse3/fuse_opt.h",
        "language": "c"
      },
      {
        "path": "/fuzz/install/include/fuse3/fuse_log.h",
        "language": "c"
      }
