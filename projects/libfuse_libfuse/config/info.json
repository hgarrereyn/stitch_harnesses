    "-I/fuzz/install/include/fuse3",
    "-L/fuzz/install/lib",
    "-L/fuzz/install/lib/x86_64-linux-gnu",
    "-lfuse3",
    "-pthread",
    "-lrt",
    "-ldl",
    "-Wl,-rpath,/fuzz/install/lib",
    "-Wl,-rpath,/fuzz/install/lib/x86_64-linux-gnu"
